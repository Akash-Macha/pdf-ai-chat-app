{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "back-end/virtual-env/Scripts/python.exe",
      "runtimeArgs": ["-c", "import os,sys,uvicorn; os.chdir('back-end'); sys.argv=['uvicorn','main:app','--reload','--port','8000']; uvicorn.main()"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "front-end", "run", "dev"],
      "port": 5173
    }
  ]
}
